# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# In AI Studio, configure via Settings > Secrets.
GEMINI_API_KEY=

# APP_URL: Public URL where this application is hosted.
APP_URL=http://localhost:3000

# Cloud SQL (PostgreSQL) Runtime Variables (injected automatically in Cloud Run/AI Studio)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Optional Third-Party AI Providers (Server-side defaults; users can also add encrypted BYOK keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OLLAMA_BASE_URL=

# Optional Search & External Data Integrations
SEARXNG_URL=
SEARCH_PROVIDER=gemini

# Optional Master Key for AES-256-GCM encrypting user BYOK API keys (falls back to ephemeral in-memory key if unset)
KEY_ENCRYPTION_SECRET=
